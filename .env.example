# Local demo without Docker. Bind the API to localhost only.
APP_HOST=127.0.0.1
APP_PORT=8000
DATABASE_URL=postgresql+asyncpg://clinic:clinic@127.0.0.1:5432/sunrise
REDIS_URL=redis://127.0.0.1:6379/0
CLINIC_TIMEZONE=America/New_York
# Optional ISO timestamp used to demo after-hours. Empty uses the real clock.
CLOCK_OVERRIDE=
RECORDING_RETENTION_DAYS=7
TRANSCRIPT_RETENTION_DAYS=30

# Filled when the self-hosted LiveKit server from Docker is running.
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=sunrise-local-livekit-secret-32ch

OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen2.5:3b
KOKORO_BASE_URL=http://127.0.0.1:8880/v1
KOKORO_VOICE=af_heart
WHISPER_MODEL=distil-large-v3
WHISPER_DEVICE=cuda

# Self-hosted Langfuse (docker compose). Matches LANGFUSE_INIT_* in compose.
LANGFUSE_HOST=http://127.0.0.1:3000
LANGFUSE_PUBLIC_KEY=pk-lf-sunrise-local-public
LANGFUSE_SECRET_KEY=sk-lf-sunrise-local-secret
